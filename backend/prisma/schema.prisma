generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum NotificationLevel {
  success
  warning
  info
}

enum DebtType {
  borrowed
  lent
}

enum DebtStatus {
  pending
  partial
  paid
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions  Transaction[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  debts         Debt[]
  debtPayments  DebtPayment[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
}

model Debt {
  id              String     @id @default(uuid())
  userId          String
  personName      String
  type            DebtType
  principalAmount Decimal    @db.Decimal(18, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(18, 2)
  description     String     @default("")
  startDate       DateTime   @db.Date
  dueDate         DateTime?  @db.Date
  status          DebtStatus @default(pending)
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, type])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model DebtPayment {
  id          String   @id @default(uuid())
  debtId      String
  userId      String
  amount      Decimal  @db.Decimal(18, 2)
  paymentDate DateTime @db.Date
  note        String   @default("")
  createdAt   DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debtId, paymentDate])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  category    String
  description String          @default("")
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, category])
}

model Budget {
  id          String             @id @default(uuid())
  userId      String
  category    String
  limitAmount Decimal            @db.Decimal(18, 2)
  month       String             @db.VarChar(7)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  alertStates BudgetAlertState[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model BudgetAlertState {
  id        String   @id @default(uuid())
  budgetId  String
  threshold Int
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, threshold])
  @@index([budgetId])
}

model SavingsGoal {
  id           String   @id @default(uuid())
  userId       String
  name         String
  targetAmount Decimal  @db.Decimal(18, 2)
  savedAmount  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  title     String
  message   String
  createdAt DateTime          @default(now())
  read      Boolean           @default(false)
  level     NotificationLevel @default(info)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
  
}
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
